{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-build.py\"",
            "timeout": 60,
            "statusMessage": "Đang build lại trang bài học / quiz..."
          }
        ]
      }
    ]
  }
}
